{
  "name": "a11y-assistant",
  "version": "0.7.0",
  "description": "A tiny accessibility assistant CLI to detect and explain common a11y issues",
  "main": "index.js",
  "keywords": [
    "accessibility",
    "a11y",
    "assistant",
    "web"
  ],
  "author": "Radosvet Petrov",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "axe-core": "^4.10.3",
    "boxen": "^8.0.1",
    "jsdom": "^26.1.0"
  },
  "scripts": {
    "start": "node dist/index.js example.html",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "eslint . --ext .js,.ts",
    "dev": "tsx src/index.ts example.html",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "chalk": "^5.6.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "ora": "^8.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
